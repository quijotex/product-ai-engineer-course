# mock es el valor por defecto. real solo entra con las credenciales de abajo.
CALENDAR_MODE=mock
WHATSAPP_MODE=mock

# Calendar real: API de Google Calendar. Sin estos datos, sigue en mock.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TOKEN=

# WhatsApp real: WhatsApp Cloud API. Sin estos datos, sigue en mock.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

PORT=3000
